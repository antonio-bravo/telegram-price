# ============================================================
# CONFIGURACIÓN DEL MONITOR DE PRECIOS PARA DOCKER / NAS
# ============================================================
# Copia este archivo como .env y rellena tus datos:
#   cp .env.example .env
#
# NOTA: Las credenciales de Telegram se pueden inyectar directamente
# en las variables de entorno de 'docker-compose.yml' o en este archivo .env.
# Tu archivo 'config.json' queda limpio de credenciales y seguro para git.

# Token de tu bot de Telegram (facilitado por @BotFather)
TELEGRAM_BOT_TOKEN=

# ID de tu chat o canal de Telegram (donde se enviarán las alertas)
TELEGRAM_CHAT_ID=

# Frecuencia de rastreo en minutos (ejemplos: 30, 60, 120)
CHECK_INTERVAL_MINUTES=60

# Ejecutar inmediatamente una búsqueda al encender el contenedor (true/false)
RUN_ON_STARTUP=true

# Modo residencial: al estar en tu NAS (IP de tu casa), permite rastrear
# Amazon, Wallapop y Vinted directamente sin los bloqueos de centros de datos de Azure.
MODO_RESIDENCIAL=true

# Zona horaria (para los logs y el histórico CSV)
TZ=Europe/Madrid

# ============================================================
# AUTENTICACIÓN DEL PANEL WEB (OPCIONAL)
# ============================================================
# Si configuras usuario y contraseña, el panel web requerirá login (HTTP Basic Auth).
# Si los dejas vacíos, el panel funcionará sin contraseña directamente.
AUTH_USER=
AUTH_PASSWORD=

# ============================================================
# SINCRONIZACIÓN CON GITHUB (OPCIONAL / RENDER.COM / NUBE)
# ============================================================
# Si ejecutas el contenedor en un entorno sin discos persistentes (como Render.com),
# puedes mantener config.json, historico.csv y monitor_state.json sincronizados
# automáticamente con tu repositorio de GitHub mediante la API REST.
# GITHUB_TOKEN: Personal Access Token de GitHub con permiso de escritura en contenidos
GITHUB_TOKEN=
GITHUB_REPO=antonio-bravo/telegram-price
GITHUB_BRANCH=main

